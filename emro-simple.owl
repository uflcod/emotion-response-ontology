    <!-- http://purl.obolibrary.org/obo/EMRO_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0000035">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A process quality that characterizes the degree of positivity or negativity of an emotion process.</obo:IAO_0000115>
        <obo:IAO_0000589>emotional valence (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-0766-8455"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-17T20:06:41Z</terms:created>
        <terms:description>the value associated with a stimulus as expressed on a continuum from pleasant to unpleasant or from attractive to aversive. In factor analysis and multidimensional scaling studies, emotional valence is one of two axes (or dimensions) on which an emotion can be located, the other axis being arousal (expressed as a continuum from high to low). For example, happiness is typically characterized by pleasant valence and relatively high arousal, whereas sadness or depression is typically characterized by unpleasant valence and relatively low arousal.</terms:description>
        <oboInOwl:hasRelatedSynonym>hedonic tone</oboInOwl:hasRelatedSynonym>
        <rdfs:comment>According to cognitive appraisal theory, an individual&apos;s cognitive appraisal of a stimulus contributes to producing an emotion (with its corresponding emotional valence).</rdfs:comment>
        <rdfs:label xml:lang="en">emotional valence</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000035"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process quality that characterizes the degree of positivity or negativity of an emotion process.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/emotional-valence</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003000">
        <obo:IAO_0000115>A behavioral defense response in which an organism seeks to avoid an encounter with a potential external threat.</obo:IAO_0000115>
        <obo:IAO_0000589>avoidance response behavior (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9990-8331"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0003-7246-1252"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:41:52Z</terms:created>
        <rdfs:label xml:lang="en">avoidance response behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000002"/>
        <obo:IAO_0000115>An emotional experience generated when events reflect on the worth or value of the self in one’s own or others’ eyes.</obo:IAO_0000115>
        <obo:IAO_0000589>self-conscious emotional experience (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:44:41Z</terms:created>
        <rdfs:label xml:lang="en">self-conscious emotional experience</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An emotional experience generated when events reflect on the worth or value of the self in one’s own or others’ eyes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/self-conscious-emotion</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003001"/>
        <obo:IAO_0000115>A self-conscious emotional experience in which a person feels awkward or flustered in other people’s company or because of the attention of others, as, for example, when being observed engaging in actions that are subject to mild disapproval from others.</obo:IAO_0000115>
        <obo:IAO_0000589>embarrassment (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:47:27Z</terms:created>
        <rdfs:label xml:lang="en">embarrassment</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D000078385</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MFOEM_000054</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C62187</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A self-conscious emotional experience in which a person feels awkward or flustered in other people’s company or because of the attention of others, as, for example, when being observed engaging in actions that are subject to mild disapproval from others.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/embarrassment</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003001"/>
        <obo:IAO_0000115>A highly unpleasant self-conscious emotional experience arising from the sense of there being something dishonorable, immodest, or indecorous in one’s own conduct or circumstances.</obo:IAO_0000115>
        <obo:IAO_0000589>shame (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:55:14Z</terms:created>
        <rdfs:label xml:lang="en">shame</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D012752</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MFOEM_000055</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C73431</skos:closeMatch>
        <skos:closeMatch>http://semanticscience.org/resource/SIO_000865</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A highly unpleasant self-conscious emotional experience arising from the sense of there being something dishonorable, immodest, or indecorous in one’s own conduct or circumstances.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/shame</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003001"/>
        <obo:IAO_0000115>A self-conscious emotional experience that occurs when a goal has been attained and one’s achievement has been recognized and approved by others.</obo:IAO_0000115>
        <obo:IAO_0000589>pride (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:57:07Z</terms:created>
        <rdfs:label xml:lang="en">pride</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MFOEM_000041</skos:closeMatch>
        <skos:closeMatch>http://semanticscience.org/resource/SIO_000859</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A self-conscious emotional experience that occurs when a goal has been attained and one’s achievement has been recognized and approved by others.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/pride</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0003005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0003005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003001"/>
        <obo:IAO_0000115>A self-conscious emotional experience characterized by a painful appraisal of having done (or thought) something that is wrong and often by a readiness to take action designed to undo or mitigate this wrong.</obo:IAO_0000115>
        <obo:IAO_0000589>guilt (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-05-04T20:58:18Z</terms:created>
        <oboInOwl:hasBroadSynonym>self-blame</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasRelatedSynonym>excessive self-reproach</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">guilt</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D006167</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/HP_6000011</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MFOEM_000053</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C95555</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/OMIT_0007345</skos:closeMatch>
        <skos:closeMatch>http://semanticscience.org/resource/SIO_000841</skos:closeMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0003005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A self-conscious emotional experience characterized by a painful appraisal of having done (or thought) something that is wrong and often by a readiness to take action designed to undo or mitigate this wrong.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/guilt</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004000">
        <obo:IAO_0000115>A process quality that characterizes a behavioral response to stimulus that is relatively stable, consistent, and enduring.</obo:IAO_0000115>
        <obo:IAO_0000589>personality triat characteristic (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-05T19:34:58Z</terms:created>
        <terms:description>Personality triats are inferred from a pattern of behaviors, attitudes, feelings, and habits in the individual.</terms:description>
        <oboInOwl:hasExactSynonym>personality dimension</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>personality trait</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">personality trait characteristic</rdfs:label>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MF_0000203</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C17713</skos:closeMatch>
        <skos:closeMatch>http://www.ebi.ac.uk/efo/EFO_0004365</skos:closeMatch>
        <skos:prefLabel>personality trait</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process quality that characterizes a behavioral response to stimulus that is relatively stable, consistent, and enduring.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/personality-trait</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000002"/>
        <obo:IAO_0000115>An emotional experience characterized by the presence of pleasant affect (e.g., feelings of happiness) versus the absence of unpleasant affect (e.g., depressed mood).</obo:IAO_0000115>
        <obo:IAO_0000589>affective well-being (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T16:15:01Z</terms:created>
        <oboInOwl:hasExactSynonym>affective well-being</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">affective well-being</rdfs:label>
        <skos:prefLabel>affective well-being</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An emotional experience characterized by the presence of pleasant affect (e.g., feelings of happiness) versus the absence of unpleasant affect (e.g., depressed mood).</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/affective-well-being</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
        <obo:IAO_0000115>An emotion response process during which negative feelings arise from the perception that one is not spending enough time alone.</obo:IAO_0000115>
        <obo:IAO_0000589>aloneliness response process (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T16:21:21Z</terms:created>
        <oboInOwl:hasExactSynonym>aloneliness</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">aloneliness response process</rdfs:label>
        <skos:prefLabel>aloneliness response</skos:prefLabel>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004000"/>
        <obo:IAO_0000115>A personality trait characteristic that is associated with  anxiety and inhibition in social situations.</obo:IAO_0000115>
        <obo:IAO_0000119>https://dictionary.apa.org/shyness</obo:IAO_0000119>
        <obo:IAO_0000589>shyness triat characteristic (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T16:26:11Z</terms:created>
        <terms:description>It typically involves three components: (a) global feelings of emotional arousal and specific physiological experiences (e.g., pounding heart, sweating, blushing); (b) acute public self-consciousness, self-deprecation, and worries about being evaluated negatively by others; and (c) observable behavior such as quietness, gaze aversion, and social withdrawal.</terms:description>
        <oboInOwl:hasExactSynonym>shyness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>timidity</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">shyness trait characteristic</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D012792</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/OMIT_0013683</skos:closeMatch>
        <skos:closeMatch>http://semanticscience.org/resource/SIO_000867</skos:closeMatch>
        <skos:prefLabel>shyness</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A personality trait characteristic that is associated with  anxiety and inhibition in social situations.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/shyness</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004000"/>
        <obo:IAO_0000115>A personality trait characteristic involving an orientation toward the internal private world of one’s self and one’s inner thoughts and feelings, rather than toward the outer world of people and things.</obo:IAO_0000115>
        <obo:IAO_0000589>introversion triat characteristic (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T16:35:23Z</terms:created>
        <oboInOwl:hasExactSynonym>introversion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>psychology introversion</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">introversion trait characteristic</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D007439</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/GSSO_007104</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/MF_0000026</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/OMIT_0008556</skos:closeMatch>
        <skos:prefLabel>introversion</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A personality trait characteristic involving an orientation toward the internal private world of one’s self and one’s inner thoughts and feelings, rather than toward the outer world of people and things.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/introversion</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
        <obo:IAO_0000115>An emotion response process involving a negative affective state, ranging from unhappiness and discontent to an extreme feeling of sadness, pessimism, and despondency, that interferes with daily life.</obo:IAO_0000115>
        <obo:IAO_0000589>depression response process (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T16:40:11Z</terms:created>
        <oboInOwl:hasExactSynonym>depression</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>depressive episode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>depressivity</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">depression response process</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D003863</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/HP_0000716</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C2982</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/OMIT_0005139</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SCDO_0000360</skos:closeMatch>
        <skos:closeMatch>http://semanticscience.org/resource/SIO_000824</skos:closeMatch>
        <skos:prefLabel>depression response</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An emotion response process involving a negative affective state, ranging from unhappiness and discontent to an extreme feeling of sadness, pessimism, and despondency, that interferes with daily life.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/depression</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004010">
        <obo:IAO_0000115>A process quality characterizing the attitudes, values, and behaviors of a population or shared by a particular group within a society, such as a profession, social class, or age group.</obo:IAO_0000115>
        <obo:IAO_0000589>societal culture characteristic (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T17:03:30Z</terms:created>
        <terms:description>The values, beliefs, language, rituals, traditions, and other behaviors that are passed from one generation to another within any social group. Broad definitions include any socially definable group with its own set of values, behaviors, and beliefs. Accordingly, cultural groups could include groups based on shared identities such as ethnicity.</terms:description>
        <oboInOwl:hasExactSynonym>social culture</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cultural background</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cultural belief</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cultural value</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">societal culture characteristic</rdfs:label>
        <skos:closeMatch>http://addictovocab.org/ADDICTO_0001365</skos:closeMatch>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D003469</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C16478</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/SCDO_0000299</skos:closeMatch>
        <skos:prefLabel>culture</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process quality characterizing the attitudes, values, and behaviors of a population or shared by a particular group within a society, such as a profession, social class, or age group.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/culture</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004011">
        <obo:IAO_0000115>A cognitive process during which an individual produces or develops original work, theories, techniques, or thoughts.</obo:IAO_0000115>
        <obo:IAO_0000589>creativity (EMRO)</obo:IAO_0000589>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6906-5548"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9625-1899"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7282-0836"/>
        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T17:06:26Z</terms:created>
        <oboInOwl:hasExactSynonym>creativity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>creative ability</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>creative thinking</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>creativeness</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">creativity</rdfs:label>
        <skos:closeMatch>http://id.nlm.nih.gov/mesh/D003405</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/OMIT_0004700</skos:closeMatch>
        <skos:closeMatch>http://purl.obolibrary.org/obo/T4FS_0000165</skos:closeMatch>
        <skos:prefLabel>creativity</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cognitive process during which an individual produces or develops original work, theories, techniques, or thoughts.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/creativity</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
        <obo:IAO_0000115>An emotion response process that is a physiological or psychological response to internal or external stressors.</obo:IAO_0000115>
        <obo:IAO_0000589>stress response process (EMRO)</obo:IAO_0000589>
