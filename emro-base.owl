        <owl:annotatedTarget>An emotion response process involving voluntary or involuntary absence of contact with others.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/social-isolation</obo:IAO_0000119>
    </owl:Axiom>
    


