        <skos:closeMatch>http://purl.obolibrary.org/obo/NCIT_C35041</skos:closeMatch>
        <skos:closeMatch>http://snomed.info/id/73595000</skos:closeMatch>
        <skos:prefLabel>stress response</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/EMRO_0004012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An emotion response process that is a physiological or psychological response to internal or external stressors.</owl:annotatedTarget>
        <obo:IAO_0000119>https://dictionary.apa.org/stress</obo:IAO_0000119>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/EMRO_0004013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
        <obo:IAO_0000115>An emotion response process involving voluntary or involuntary absence of contact with others.</obo:IAO_0000115>
