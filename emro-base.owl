        <terms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-06-08T17:50:36Z</terms:created>
        <terms:description>Stress involves changes affecting nearly every system of the body, influencing how people feel and behave.</terms:description>
        <oboInOwl:hasExactSynonym>psychological stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>state of stress</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stress</oboInOwl:hasExactSynonym>
        <rdfs:label xml:lang="en">stress response process</rdfs:label>
