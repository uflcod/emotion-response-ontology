    <!-- http://purl.obolibrary.org/obo/EMRO_0004017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/EMRO_0004017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/EMRO_0000000"/>
